// enum type start

enum UserRole {
  CUSTOMER
  ADMIN
  VENDOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING_VERIFICATION
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
  EXPIRED
}

enum OrderEventType {
  ORDER_CREATED
  PAYMENT_RECEIVED
  ORDER_CONFIRMED
  ORDER_PACKED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  REFUND_COMPLETED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  SSLCOMMERZ
  STRIPE
  PAYPAL
  BANK_TRANSFER
}

enum PaymentTransactionStatus {
  PENDING
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  COLLECTED
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum PaymentEventType {
  PAYMENT_CREATED
  PAYMENT_PROCESSING
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_CANCELLED
  REFUND_CREATED
  REFUND_COMPLETED
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT

