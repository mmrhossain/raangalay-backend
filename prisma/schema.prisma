model Cart {
  id             String     @id @default(uuid())
  status         CartStatus @default(ACTIVE)
  subtotal       Decimal    @default(0) @db.Decimal(18, 2)
  discountAmount Decimal    @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal    @default(0) @db.Decimal(18, 2)
  shippingAmount Decimal    @default(0) @db.Decimal(18, 2)
  grandTotal     Decimal    @default(0) @db.Decimal(18, 2)

  items      CartItem[]
  activities CartActivity[]
  coupon     CartCoupon?

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([customerProfileId])
  @@index([status])
}

model CartItem {
  id           String  @id @default(uuid())
  quantity     Int
  productName  String
  productSlug  String?
  productImage String?
  sku          String
  unitPrice    Decimal @db.Decimal(18, 2)
  subtotal     Decimal @db.Decimal(18, 2)

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model CartCoupon {
  id             String  @id @default(uuid())
  couponCode     String
  discountAmount Decimal @db.Decimal(18, 2)

  cartId String @unique
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  appliedAt DateTime @default(now())
}

model CartActivity {
  id        String        @id @default(uuid())
  eventType CartEventType
  metadata  Json?

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
}

//For mobile app and anonymous users.

model GuestCart {
  id        String @id @default(uuid())
  sessionId String @unique
  cartData  Json

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                String            @id @default(uuid())
  orderNumber       String            @unique
  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  currency          Currency          @default(BDT)
  subtotal          Decimal           @db.Decimal(18, 2)
  discountAmount    Decimal           @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal           @default(0) @db.Decimal(18, 2)
  shippingAmount    Decimal           @default(0) @db.Decimal(18, 2)
  grandTotal        Decimal           @db.Decimal(18, 2)
  notes             String?

  items         OrderItem[]
  payments      Payment[]
  events        OrderEvent[]
  statusHistory OrderStatusHistory[]
  shipments     Shipment[]
  couponUsages  CouponUsage[]

  // posOrders PosOrder[]
  // externalOrderMappings ExternalOrderMapping[]

  billingAddress  BillingAddress?
  shippingAddress ShippingAddress?

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])

  // salesChannelId String?
  // salesChannel   SalesChannel? @relation(fields: [salesChannelId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerProfileId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id             String  @id @default(uuid())
  productName    String
  sku            String
  variantName    String?
  quantity       Int
  unitPrice      Decimal @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal @default(0) @db.Decimal(18, 2)
  subtotal       Decimal @db.Decimal(18, 2)

  shipmentItems ShipmentItem[]

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([sku])
}

model BillingAddress {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fullName     String
  phone        String
  email        String?
  country      String
  state        String?
  city         String
  area         String?
  postalCode   String?
  addressLine1 String
  addressLine2 String?
}

model ShippingAddress {
  id           String  @id @default(uuid())
  fullName     String
  phone        String
  email        String?
  country      String
  state        String?
  city         String
  area         String?
  postalCode   String?
  addressLine1 String
  addressLine2 String?

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// Critical for:

// Tracking
// Customer Support
// AI Agent

model OrderStatusHistory {
  id        String      @id @default(uuid())
  status    OrderStatus
  remarks   String?
  changedBy String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

model OrderEvent {
  id        String         @id @default(uuid())
  eventType OrderEventType
  metadata  Json?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

// End of Customer & Order Management models. Critical for CRM, order processing, and customer experience.

// Payment & Inventory models start here. Critical for payment processing, inventory management, and order fulfillment.

model Payment {
  id                String                   @id @default(uuid())
  method            PaymentMethod
  status            PaymentTransactionStatus @default(PENDING)
  amount            Decimal                  @db.Decimal(18, 2)
  currency          Currency                 @default(BDT)
  provider          String?
  providerReference String?                  @unique
  paymentIntentId   String?
  paidAt            DateTime?
  expiresAt         DateTime?

  refunds      Refund[]
  transactions PaymentTransaction[]
  events       PaymentEvent[]
  // reconciliation PaymentReconciliation?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orderId])
  @@index([status])
  @@index([method])
}

model PaymentTransaction {
  id                   String                   @id @default(uuid())
  transactionReference String?
  gatewayResponse      Json?
  status               PaymentTransactionStatus
  amount               Decimal                  @db.Decimal(18, 2)

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
}

model Refund {
  id                String       @id @default(uuid())
  amount            Decimal      @db.Decimal(18, 2)
  reason            String?
  status            RefundStatus @default(PENDING)
  providerReference String?
  refundedAt        DateTime?

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
}

model PaymentWebhookLog {
  id              String    @id @default(uuid())
  provider        String
  eventType       String
  externalEventId String?
  payload         Json
  processed       Boolean   @default(false)
  processedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalEventId])
  @@index([provider])
  @@index([processed])
}

model PaymentEvent {
  id        String           @id @default(uuid())
  eventType PaymentEventType
  metadata  Json?

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
}

model Warehouse {
  id           String  @id @default(uuid())
  name         String
  code         String  @unique
  phone        String?
  email        String?
  country      String
  state        String?
  city         String
  addressLine1 String
  addressLine2 String?
  isActive     Boolean @default(true)

  inventories       Inventory[]
  stockReservations StockReservation[]
  transactions      InventoryTransaction[]
  adjustments       InventoryAdjustment[]
  shipments         Shipment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([code])
}

model Inventory {
  id                String    @id @default(uuid())
  quantityOnHand    Int       @default(0)
  quantityReserved  Int       @default(0)
  quantityAvailable Int       @default(0)
  lastTransactionAt DateTime?

  transactions InventoryTransaction[]

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, variantId])
  @@index([warehouseId])
  @@index([variantId])
}

model StockReservation {
  id       String @id @default(uuid())
  orderId  String
  quantity Int

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, variantId, warehouseId])
  @@index([orderId])
  @@index([variantId])
  @@index([warehouseId])
}

model InventoryTransaction {
  id            String                   @id @default(uuid())
  type          InventoryTransactionType
  quantity      Int
  referenceType String?
  referenceId   String?
  remarks       String?
  createdBy     String?

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inventoryId])
  @@index([variantId])
  @@index([warehouseId])
  @@index([type])
  @@index([referenceId])
}

model InventoryAdjustment {
  id               String                    @id @default(uuid())
  previousQuantity Int
  adjustedQuantity Int
  difference       Int
  reason           String
  status           InventoryAdjustmentStatus @default(PENDING)
  approvedBy       String?

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId])
  @@index([variantId])
}

model InventoryTransfer {
  id              String         @id @default(uuid())
  fromWarehouseId String
  toWarehouseId   String
  status          TransferStatus @default(PENDING)
  remarks         String?

  items InventoryTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model InventoryTransferItem {
  id       String @id @default(uuid())
  quantity Int

  transferId String
  transfer   InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([transferId])
}

model InventoryEvent {
  id          String             @id @default(uuid())
  warehouseId String
  eventType   InventoryEventType
  metadata    Json?

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId])
}

model Shipment {
  id                String          @id @default(uuid())
  shipmentNumber    String          @unique
  courierProvider   CourierProvider
  status            ShipmentStatus  @default(PENDING)
  trackingNumber    String?
  courierReference  String?
  labelUrl          String?
  pickupRequestedAt DateTime?
  pickedUpAt        DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  returnedAt        DateTime?
  shippingCost      Decimal         @default(0) @db.Decimal(18, 2)
  notes             String?

  items            ShipmentItem[]
  trackingEvents   ShipmentTracking[]
  deliveryAttempts DeliveryAttempt[]
  shipmentAddress  ShipmentAddress?
  events           ShipmentEvent[]

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([trackingNumber])
}

model ShipmentItem {
  id       String @id @default(uuid())
  quantity Int

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([shipmentId])
  @@index([orderItemId])
}

model ShipmentTracking {
  id String @id @default(uuid())

  status      ShipmentStatus
  location    String?
  description String?
  eventTime   DateTime

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
}

model DeliveryAttempt {
  id            String   @id @default(uuid())
  attemptNumber Int
  remarks       String?
  attemptedAt   DateTime

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
}

model CourierWebhookLog {
  id              String          @id @default(uuid())
  provider        CourierProvider
  eventType       String
  externalEventId String?
  payload         Json
  processed       Boolean         @default(false)

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([processed])
}

model ShipmentAddress {
  id           String  @id @default(uuid())
  fullName     String
  phone        String
  email        String?
  country      String
  state        String?
  city         String
  area         String?
  postalCode   String?
  addressLine1 String
  addressLine2 String?

  shipmentId String   @unique
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model ShipmentEvent {
  id        String            @id @default(uuid())
  eventType ShipmentEventType
  metadata  Json?

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
}

// end of Payment & Inventory models. Critical for payment processing, inventory management, and order fulfillment.

// Promotion & Marketing models start here. Critical for customer acquisition, retention, and revenue growth.

model Coupon {
  id                    String       @id @default(uuid())
  code                  String       @unique
  name                  String
  description           String?
  status                CouponStatus @default(DRAFT)
  discountType          DiscountType
  discountValue         Decimal      @db.Decimal(18, 2)
  minimumOrderAmount    Decimal?     @db.Decimal(18, 2)
  maximumDiscountAmount Decimal?     @db.Decimal(18, 2)
  usageLimit            Int?
  usageCount            Int          @default(0)
  usageLimitPerCustomer Int?
  startsAt              DateTime
  expiresAt             DateTime
  isActive              Boolean      @default(true)
  applicableProductIds  String[]
  applicableCategoryIds String[]

  usages CouponUsage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([code])
  @@index([status])
}

model CouponUsage {
  id             String  @id @default(uuid())
  discountAmount Decimal @db.Decimal(18, 2)

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id])

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  usedAt DateTime @default(now())

  @@index([couponId])
  @@index([customerProfileId])
}

